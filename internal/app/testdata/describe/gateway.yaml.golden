item:
  conditions:
  - conditions:
    - lastTransition: "2026-01-01T00:00:00Z"
      observedGeneration: 1
      reason: Accepted
      status: "True"
      type: Accepted
    - lastTransition: "2026-01-01T00:00:00Z"
      observedGeneration: 1
      reason: Programmed
      status: "True"
      type: Programmed
    scope: object
  - conditions:
    - lastTransition: "2026-01-01T00:00:00Z"
      observedGeneration: 1
      reason: Accepted
      status: "True"
      type: Accepted
    - lastTransition: "2026-01-01T00:00:00Z"
      observedGeneration: 1
      reason: Programmed
      status: "True"
      type: Programmed
    - lastTransition: "2026-01-01T00:00:00Z"
      observedGeneration: 1
      reason: ResolvedRefs
      status: "True"
      type: ResolvedRefs
    scope: listener http
  object:
    age: 10d
    creationTimestamp: "X"
    generation: 1
    group: gateway.networking.k8s.io
    install: kgateway-system/kgateway
    kind: Gateway
    name: http
    namespace: kgateway-system
    observedGeneration: 1
  relations:
    attachedRoutes:
    - listener: http
      routes:
      - HTTPRoute/default/example
    listenerSets:
    - ListenerSet/extra
    - XListenerSet/extra-x
    notAccepted:
    - attachment: not-accepted
      condition: 'Accepted=False (NotAllowedByListeners): hostname rejected.example.com
        matches no listener'
      listener: http
      route: HTTPRoute/default/rejected
    - attachment: pending
      condition: no status from the controller
      listener: ListenerSet/extra:*
      route: HTTPRoute/via-extra
    - attachment: pending
      condition: no status from the controller
      listener: XListenerSet/extra-x:*
      route: HTTPRoute/via-extra-x
    resolved: true
  spec:
    class: kgateway
    listeners:
    - allowedRoutes: from All
      name: http
      port: 8080
      protocol: HTTP
kind: Describe
schemaVersion: kgwctl.kgateway.dev/v1alpha1
