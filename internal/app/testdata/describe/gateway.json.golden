{
  "schemaVersion": "kgwctl.kgateway.dev/v1alpha1",
  "kind": "Describe",
  "item": {
    "object": {
      "kind": "Gateway",
      "group": "gateway.networking.k8s.io",
      "namespace": "kgateway-system",
      "name": "http",
      "install": "kgateway-system/kgateway",
      "creationTimestamp": "X",
      "age": "10d",
      "generation": 1,
      "observedGeneration": 1
    },
    "spec": {
      "class": "kgateway",
      "listeners": [
        {
          "name": "http",
          "port": 8080,
          "protocol": "HTTP",
          "allowedRoutes": "from All"
        }
      ]
    },
    "conditions": [
      {
        "scope": "object",
        "conditions": [
          {
            "type": "Accepted",
            "status": "True",
            "reason": "Accepted",
            "lastTransition": "2026-01-01T00:00:00Z",
            "observedGeneration": 1
          },
          {
            "type": "Programmed",
            "status": "True",
            "reason": "Programmed",
            "lastTransition": "2026-01-01T00:00:00Z",
            "observedGeneration": 1
          }
        ]
      },
      {
        "scope": "listener http",
        "conditions": [
          {
            "type": "Accepted",
            "status": "True",
            "reason": "Accepted",
            "lastTransition": "2026-01-01T00:00:00Z",
            "observedGeneration": 1
          },
          {
            "type": "Programmed",
            "status": "True",
            "reason": "Programmed",
            "lastTransition": "2026-01-01T00:00:00Z",
            "observedGeneration": 1
          },
          {
            "type": "ResolvedRefs",
            "status": "True",
            "reason": "ResolvedRefs",
            "lastTransition": "2026-01-01T00:00:00Z",
            "observedGeneration": 1
          }
        ]
      }
    ],
    "relations": {
      "resolved": true,
      "attachedRoutes": [
        {
          "listener": "http",
          "routes": [
            "HTTPRoute/default/example"
          ]
        }
      ],
      "notAccepted": [
        {
          "route": "HTTPRoute/default/rejected",
          "listener": "http",
          "attachment": "not-accepted",
          "condition": "Accepted=False (NotAllowedByListeners): hostname rejected.example.com matches no listener"
        },
        {
          "route": "HTTPRoute/via-extra",
          "listener": "ListenerSet/extra:*",
          "attachment": "pending",
          "condition": "no status from the controller"
        },
        {
          "route": "HTTPRoute/via-extra-x",
          "listener": "XListenerSet/extra-x:*",
          "attachment": "pending",
          "condition": "no status from the controller"
        }
      ],
      "listenerSets": [
        "ListenerSet/extra",
        "XListenerSet/extra-x"
      ]
    }
  }
